    }

    JOBS {
        int job_id PK
        int company_id FK
        int city_id FK
        varchar title
    }

    JOB_SKILLS {
        int job_id PK, FK
        int skill_id PK, FK
    }

    APPLICATIONS {
        int application_id PK
        int job_id FK
        int member_id FK
        varchar status
    }

    CONNECTIONS {
        int member_a PK, FK
        int member_b PK, FK
    }

    INVITATIONS {
        int invitation_id PK
        int sender_id FK
        int recipient_id FK
        varchar status
    }

    PROFILE_VIEWS {
        int view_id PK
        int viewer_id FK "nullable"
        int viewed_id FK
    }
